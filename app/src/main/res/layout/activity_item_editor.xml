<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".ItemEditorActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:id="@+id/tvEditorTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/editor_title_new"
            style="@style/ScreenTitle" />

        <TextView
            android:id="@+id/tvAiNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/editor_ai_note"
            android:visibility="gone"
            style="@style/BodySecondary" />

        <ImageView
            android:id="@+id/ivItem"
            android:layout_width="match_parent"
            android:layout_height="240dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_image_placeholder"
            android:contentDescription="@string/img_preview_desc"
            android:padding="8dp"
            android:scaleType="centerInside" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_category"
            style="@style/SectionLabel" />

        <Spinner
            android:id="@+id/spCategory"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_type"
            style="@style/SectionLabel" />

        <Spinner
            android:id="@+id/spType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_color"
            style="@style/SectionLabel" />

        <Spinner
            android:id="@+id/spColor"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_secondary_color"
            style="@style/SectionLabel" />

        <Spinner
            android:id="@+id/spColor2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_pattern"
            style="@style/SectionLabel" />

        <Spinner
            android:id="@+id/spPattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_formality"
            style="@style/SectionLabel" />

        <RadioGroup
            android:id="@+id/rgFormality"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <RadioButton
                android:id="@+id/rbCasual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/formality_casual" />

            <RadioButton
                android:id="@+id/rbSmartCasual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/formality_smart_casual" />

            <RadioButton
                android:id="@+id/rbFormal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/formality_formal" />

            <RadioButton
                android:id="@+id/rbFestive"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/formality_festive" />
        </RadioGroup>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/label_seasons"
            style="@style/SectionLabel" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <CheckBox
                android:id="@+id/cbSummer"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/season_summer" />

            <CheckBox
                android:id="@+id/cbMonsoon"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/season_monsoon" />

            <CheckBox
                android:id="@+id/cbWinter"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/season_winter" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/cbLaundry"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/cb_in_laundry"
            android:textColor="@color/laundry"
            android:visibility="gone" />

        <TextView
            android:id="@+id/tvWornStats"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            style="@style/BodySecondary" />

        <Button
            android:id="@+id/btnSave"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:layout_marginTop="24dp"
            android:text="@string/btn_save"
            android:textSize="17sp" />

        <Button
            android:id="@+id/btnDelete"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="8dp"
            android:text="@string/btn_delete"
            android:textColor="@color/danger"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
