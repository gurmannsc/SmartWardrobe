<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/tvOutfitName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/primary"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- Up to 5 item photos per outfit; unused slots stay empty -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/ivOutfit1"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/outfit_item_desc"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivOutfit2"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/outfit_item_desc"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivOutfit3"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/outfit_item_desc"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivOutfit4"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginEnd="6dp"
            android:contentDescription="@string/outfit_item_desc"
            android:scaleType="centerCrop" />

        <ImageView
            android:id="@+id/ivOutfit5"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:contentDescription="@string/outfit_item_desc"
            android:scaleType="centerCrop" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvOutfitItems"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/text_primary"
        android:textSize="14sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvOutfitReason"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        style="@style/BodySecondary" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:gravity="end"
        android:text="@string/outfit_tap_to_wear"
        android:textColor="@color/accent"
        android:textSize="12sp"
        android:textStyle="bold" />
</LinearLayout>
